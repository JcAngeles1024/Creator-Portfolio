# Template for .env — copy this file to .env and fill in the values.
# Leave a value blank to run without that integration: the contact form still
# works, emails are logged to the server console and rate limiting is skipped.

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
# Use "Portfolio <onboarding@resend.dev>" to test before your domain is verified.
CONTACT_FROM_EMAIL=
# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=

# Upstash Redis — https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
